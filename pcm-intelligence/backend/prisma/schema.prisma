generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
 directUrl = env("DATABASE_URL_UNPOOLED")
}
enum RoleName {
 ADMIN
 MANAGER
 PLANNER
 TECHNICIAN
 VIEWER
}
model Role {
 id String @id @default(cuid())
 name RoleName @unique
 users User[]
}
model User {
 id String @id @default(cuid())
 name String
 createdAt DateTime @default(now())
 email String @unique
 passwordHash String
 mustChangePassword Boolean @default(false)
 active Boolean @default(true)
 technicianId String? @unique
 technician Technician? @relation(fields: [technicianId], references: [id])
 roleId String
 role Role @relation(fields: [roleId], references: [id])
 sessions Session[]
 audits AuditLog[]
 orderChanges OrderHistory[]
 importBatches ImportBatch[]
 scheduleChanges AssignmentHistory[]
}
model Session {
 id String @id
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 expiresAt DateTime
 @@index([expiresAt])
}
model Sector {
 id String @id
 name String @unique
 equipment Equipment[]
}
model Equipment {
 id String @id
 version Int @default(1)
 name String
 criticality Int
 status String
 isDemo Boolean @default(true)
 sectorId String
 sector Sector @relation(fields: [sectorId], references: [id])
 interruptions Interruption[]
 orders MaintenanceOrder[]
 plans MaintenancePlan[]
 @@index([sectorId, criticality])
}
model Technician {
 id String @id
 active Boolean @default(true)
 isDemo Boolean @default(true)
 name String
 specialty String
 user User?
 workWindows TechnicianWorkWindow[]
 absences TechnicianAbsence[]
 assignments TechnicianAssignment[]
 plans MaintenancePlan[]
 orders MaintenanceOrder[]
}
model Interruption {
 id String @id
 version Int @default(1)
 equipmentId String
 equipment Equipment @relation(fields: [equipmentId], references: [id])
 startedAt DateTime
 endedAt DateTime?
 durationMinutes Int?
 type String
 reason String
 description String
 status String @default("CLOSED")
 source String @default("DEMO")
 isDemo Boolean @default(true)
 @@index([equipmentId, startedAt])
}
model MaintenanceOrder {
 id String @id
 version Int @default(1)
 history OrderHistory[]
 equipmentId String
 equipment Equipment @relation(fields: [equipmentId], references: [id])
 technicianId String?
 technician Technician? @relation(fields: [technicianId], references: [id])
 type String
 description String
 priority Int
 status String
 openedAt DateTime?
 scheduledAt DateTime?
 completedAt DateTime?
 notes String?
 sapReference String?
 isDemo Boolean @default(true)
 assignments TechnicianAssignment[]
 services ThirdPartyService[]
 @@index([status, scheduledAt])
}
model TechnicianAssignment {
 id String @id @default(cuid())
 version Int @default(1)
 technicianId String
 technician Technician @relation(fields: [technicianId], references: [id])
 orderId String?
 order MaintenanceOrder? @relation(fields: [orderId], references: [id])
 planId String?
 plan MaintenancePlan? @relation(fields: [planId], references: [id])
 scheduledFor DateTime?
 startsAt DateTime
 endsAt DateTime
 status String @default("SCHEDULED")
 actualStartedAt DateTime?
 completedAt DateTime?
 notes String?
 createdAt DateTime @default(now())
 history AssignmentHistory[]
 @@index([technicianId, startsAt])
 @@index([orderId, status])
 @@index([planId, status])
 @@index([startsAt, endsAt])
}
model MaintenancePlan {
 id String @id
 title String @default("Plano de manutenção")
 version Int @default(1)
 equipmentId String
 equipment Equipment @relation(fields: [equipmentId], references: [id])
 technicianId String
 technician Technician @relation(fields: [technicianId], references: [id])
 type String
 intervalDays Int
 nextExecution DateTime
 active Boolean @default(true)
 isDemo Boolean @default(true)
 executions MaintenanceExecution[]
 assignments TechnicianAssignment[]
 @@index([nextExecution])
}
model MaintenanceExecution {
 id String @id @default(cuid())
 planId String
 plan MaintenancePlan @relation(fields: [planId], references: [id])
 executedAt DateTime
 scheduledFor DateTime?
 technicianName String?
 notes String
}
model ThirdPartyService {
 id String @id
 version Int @default(1)
 provider String
 description String
 executedAt DateTime?
 internalOwner String
 orderId String
 order MaintenanceOrder @relation(fields: [orderId], references: [id])
 purchaseReference String?
 amount Decimal? @db.Decimal(12,2)
 status String
 pendingNotes String?
 stageEnteredAt DateTime
 isDemo Boolean @default(true)
 documents ThirdPartyDocument[]
 movements ThirdPartyMovement[]
 @@index([status, stageEnteredAt])
}
model ThirdPartyDocument {
 id String @id @default(cuid())
 serviceId String
 service ThirdPartyService @relation(fields: [serviceId], references: [id])
 name String
 reference String
 requirementId String?
 requirement DocumentRequirement? @relation(fields: [requirementId], references: [id])
 verified Boolean @default(false)
 receivedAt DateTime @default(now())
}
model DocumentRequirement {
 id String @id @default(cuid())
 documents ThirdPartyDocument[]
 name String @unique
 active Boolean @default(true)
}
model ThirdPartyMovement {
 id String @id @default(cuid())
 serviceId String
 service ThirdPartyService @relation(fields: [serviceId], references: [id])
 status String
 occurredAt DateTime
 actor String
 notes String
}
model CompressedAirReading {
 id String @id
 compressor String
 sector String
 pressure Float
 flow Float
 energyKwh Float
 measuredAt DateTime
 operatingState String
 isDemo Boolean @default(true)
 @@index([compressor, measuredAt])
}
model LeakInspection {
 id String @id @default(cuid())
 compressor String
 inspectedAt DateTime
 method String
 findings String
 repairStatus String
 isDemo Boolean @default(true)
}
model Alert {
 id String @id @default(cuid())
 equipmentId String?
 message String
 evidence Json
 createdAt DateTime @default(now())
 isDemo Boolean @default(true)
}
model ImportBatch {
 id String @id @default(cuid())
 sourceConfigId String?
 sourceConfig ImportSource? @relation(fields: [sourceConfigId], references: [id])
 actorId String?
 actor User? @relation(fields: [actorId], references: [id])
 filename String?
 fileHash String?
 mapping Json?
 options Json?
 preview Json?
 payload Json?
 expiresAt DateTime?
 processed Int @default(0)
 counts Json?
 changes ImportChange[]
 source String
 status String
 createdAt DateTime @default(now())
 rowCount Int
 errors Json
 isDemo Boolean @default(true)
}
model AuditLog {
 id String @id @default(cuid())
 userId String?
 user User? @relation(fields: [userId], references: [id])
 action String
 entity String
 metadata Json
 createdAt DateTime @default(now())
 @@index([createdAt])
}

model LoginThrottle {
 id String @id
 attempts Int @default(1)
 windowStartedAt DateTime @default(now())
}

model OrderHistory {
 id String @id @default(cuid())
 orderId String
 order MaintenanceOrder @relation(fields: [orderId], references: [id])
 userId String
 user User @relation(fields: [userId], references: [id])
 action String
 before Json?
 after Json
 notes String?
 createdAt DateTime @default(now())
 @@index([orderId, createdAt])
}

model ImportSource {
 id String @id @default(cuid())
 name String @unique
 system String
 scope String
 target String
 isDemo Boolean @default(false)
 active Boolean @default(true)
 mapping Json?
 options Json?
 createdAt DateTime @default(now())
 batches ImportBatch[]
 records ExternalRecord[]
}
model ExternalRecord {
 id String @id @default(cuid())
 sourceId String
 source ImportSource @relation(fields: [sourceId], references: [id])
 externalKey String
 scope String
 entityType String
 entityId String
 contentHash String
 lastApplied Json
 appliedVersion Int
 lastBatchId String
 updatedAt DateTime @updatedAt
 @@unique([scope, entityType, externalKey])
 @@index([entityType, entityId])
}
model ImportChange {
 id String @id @default(cuid())
 sequence Int @default(autoincrement()) @unique
 batchId String
 batch ImportBatch @relation(fields: [batchId], references: [id])
 rowNumber Int
 entityType String
 entityId String
 operation String
 externalRecordId String?
 before Json?
 after Json?
 beforeLink Json?
 undone Boolean @default(false)
 createdAt DateTime @default(now())
 @@index([batchId, sequence])
}

model TechnicianWorkWindow {
 id String @id @default(cuid())
 version Int @default(1)
 technicianId String
 technician Technician @relation(fields: [technicianId], references: [id])
 weekday Int
 startMinute Int
 endMinute Int
 active Boolean @default(true)
 @@index([technicianId, weekday])
}
model TechnicianAbsence {
 id String @id @default(cuid())
 version Int @default(1)
 technicianId String
 technician Technician @relation(fields: [technicianId], references: [id])
 startsAt DateTime
 endsAt DateTime
 reason String
 active Boolean @default(true)
 @@index([technicianId, startsAt, endsAt])
}
model AssignmentHistory {
 id String @id @default(cuid())
 assignmentId String
 assignment TechnicianAssignment @relation(fields: [assignmentId], references: [id])
 userId String
 user User @relation(fields: [userId], references: [id])
 action String
 before Json?
 after Json
 notes String
 createdAt DateTime @default(now())
 @@index([assignmentId, createdAt])
}
